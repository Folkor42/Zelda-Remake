script/source = "extends Sprite2D

const NES_SPRITE = preload(\"res://Assets/SpriteSheets/NES - Items & Weapons.png\")
const SNES_SPRITE = preload(\"res://Assets/SpriteSheets/SNES - Items & Weapons.png\")
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Events.toggle_graphics.connect(toggle_graphics)
	toggle_graphics(PlayerManager.upgraded_graphics)
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func toggle_graphics( _value : bool )->void:
	if _value:
		texture=SNES_SPRITE
		frame=10
	else:
		texture=NES_SPRITE
		frame=11
"

