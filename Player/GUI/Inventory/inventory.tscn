[sub_resource type="GDScript" id="GDScript_llx3h"]
script/source = "extends Label

func _process(_delta: float) -> void:
	# Get the time dictionary
	var time = Time.get_time_dict_from_system()
	text=str(\"%02d:%02d:%02d\" % [time.hour, time.minute, time.second]) # {day:X, dst:False, hour:xx, minute:xx, month:xx, second:xx, weekday:x, year:xxxx}
"

