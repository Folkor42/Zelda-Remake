[sub_resource type="GDScript" id="GDScript_pshon"]
script/source = "extends Sprite2D

const NES_HUD : Texture = preload(\"res://Assets/SpriteSheets/NES - The Legend of Zelda - HUD & Pause Screen.png\")
const SNES_HUD : Texture = preload(\"res://Assets/SpriteSheets/SNES - HUD & Pause Screen.png\")

func _ready()->void:
	toggle_graphics(PlayerManager.upgraded_graphics)
	Events.toggle_graphics.connect(toggle_graphics)
	if PlayerManager.inventory.contents.has(\"Red Potion\"):
		print (\"Red Potion found\")
		region_rect = Rect2(704,137,8,16)
	elif PlayerManager.inventory.contents.has(\"Blue Potion\"):
		region_rect = Rect2(695,137,8,16)
		print (\"Blue Potion found\")
	else:
		region_rect = Rect2(0,0,0,0)

func toggle_graphics( _new_value : bool )->void:
	if _new_value:
		texture=SNES_HUD
	else:
		texture=NES_HUD
"

